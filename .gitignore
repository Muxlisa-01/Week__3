#include <algorithm>
#include <chrono>
#include <cstdlib>
#include <ctime>
#include <iomanip>
#include <iostream>
#include <vector>
using namespace std;
using namespace std::chrono;

void bubbleSort(int A[], int n) {
    for (int i = 0; i < n - 1; i++)
        for (int j = 0; j < n - 1 - i; j++)
            if (A[j] > A[j + 1]) {
                int temp = A[j];
                A[j] = A[j + 1];
                A[j + 1] = temp;
            }
}

typedef vector<vector<int>> Matrix;

Matrix randomMatrix(int n) {
    Matrix M(n, vector<int>(n));
    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++)
            M[i][j] = rand() % 10;
    return M;
}

void multiply(const Matrix& A, const Matrix& B, Matrix& C, int n) {
    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++) {
            int sum = 0;
            for (int k = 0; k < n; k++)
                sum += A[i][k] * B[k][j];
            C[i][j] = sum;
        }
}

long long fibRecursive(int n) {
    if (n <= 1) return n;
    return fibRecursive(n - 1) + fibRecursive(n - 2);
}

unsigned long long fibIterative(int n) {
    unsigned long long a = 0, b = 1;
    for (int i = 0; i < n; i++) {
        unsigned long long next = a + b;
        a = b;
        b = next;
    }
    return a;
}

struct Node {
    int data;
    Node* next;
};

template <class F>
double timeUs(F f) {
    auto s = high_resolution_clock::now();
    f();
    auto e = high_resolution_clock::now();
    return duration<double, micro>(e - s).count();
}

Node* buildList(int n) {
    Node* head = nullptr;
    Node* tail = nullptr;
    for (int i = 0; i < n; i++) {
        Node* nd = new Node{i, nullptr};
        if (!head) head = tail = nd;
        else { tail->next = nd; tail = nd; }
    }
    return head;
}

void freeList(Node* h) {
    while (h) { Node* nx = h->next; delete h; h = nx; }
}

int searchList(Node* h, int key) {
    int idx = 0;
    for (Node* p = h; p; p = p->next, idx++)
        if (p->data == key) return idx;
    return -1;
}

int searchArray(const int* A, int n, int key) {
    for (int i = 0; i < n; i++) if (A[i] == key) return i;
    return -1;
}

int searchVector(const vector<int>& v, int key) {
    for (size_t i = 0; i < v.size(); i++) if (v[i] == key) return (int)i;
    return -1;
}

int main() {
    srand(time_t(nullptr));
    
    {
        const int sizesSort[] = {1000, 2000, 5000, 10000, 20000, 50000, 100000};
        long long checksumSort = 0;

        cout << left << setw(10) << "n"
             << setw(20) << "bubble (ms)"
             << setw(20) << "std::sort (ms)"
             << setw(14) << "ratio" << endl;

        for (int n : sizesSort) {
            int* original = new int[n];
            for (int i = 0; i < n; i++) original[i] = rand();

            int bubbleRuns = (n >= 50000) ? 1 : 3;
            const int sortRuns = 5;

            double bubbleMs = 0, sortMs = 0;

            for (int r = 0; r < bubbleRuns; r++) {
                int* c1 = new int[n];
                copy(original, original + n, c1);
                auto s = high_resolution_clock::now();
                bubbleSort(c1, n);
                auto e = high_resolution_clock::now();
                bubbleMs += duration<double, milli>(e - s).count();
                checksumSort += c1[0];
                delete[] c1;
            }
            for (int r = 0; r < sortRuns; r++) {
                int* c2 = new int[n];
                copy(original, original + n, c2);
                auto s = high_resolution_clock::now();
                sort(c2, c2 + n);
                auto e = high_resolution_clock::now();
                sortMs += duration<double, milli>(e - s).count();
                checksumSort += c2[0];
                delete[] c2;
            }
            bubbleMs /= bubbleRuns;
            sortMs /= sortRuns;

            cout << left << setw(10) << n
                 << fixed << setprecision(3)
                 << setw(20) << bubbleMs
                 << setw(20) << sortMs
                 << setw(14) << setprecision(1) << bubbleMs / sortMs << endl;

            delete[] original;
        }
        cout << "(checksum " << checksumSort << ")" << endl;
    }

    {
        const int sizesMat[] = {50, 100, 200, 400, 800};
        double prevMs = 0;
        long long checksumMat = 0;

        cout << left << setw(8) << "n"
             << setw(18) << "multiply (ms)"
             << setw(14) << "x prev"
             << setw(20) << "approx bytes"
             << setw(18) << "time/n^3 (ns)" << endl;

        for (int n : sizesMat) {
            Matrix A = randomMatrix(n), B = randomMatrix(n);
            Matrix C(n, vector<int>(n, 0));

            int runs = (n >= 400) ? 1 : 3;
            double ms = 0;
            for (int r = 0; r < runs; r++) {
                auto s = high_resolution_clock::now();
                multiply(A, B, C, n);
                auto e = high_resolution_clock::now();
                ms += duration<double, milli>(e - s).count();
            }
            ms /= runs;
            checksumMat += C[n - 1][n - 1];

            cout << left << setw(8) << n
                 << fixed << setprecision(3) << setw(18) << ms;
            if (prevMs > 0) cout << setw(14) << setprecision(2) << ms / prevMs;
            else            cout << setw(14) << "-";
            cout << setw(20) << 3LL * n * n * sizeof(int)
                 << setw(18) << setprecision(3) << ms * 1e6 / ((double)n * n * n) << endl;
            prevMs = ms;
        }
        cout << "(checksum " << checksumMat << ")" << endl;
    }

    {
        unsigned long long checksumFib = 0;

        cout << "Recursive Fibonacci\n";
        cout << left << setw(8) << "n" << setw(16) << "result"
             << setw(18) << "time (ms)" << setw(10) << "x prev" << endl;

        double prevMs = 0;
        for (int n : {20, 25, 30, 35}) {
            auto s = high_resolution_clock::now();
            long long f = fibRecursive(n);
            auto e = high_resolution_clock::now();
            double ms = duration<double, milli>(e - s).count();
            checksumFib += f;

            cout << left << setw(8) << n << setw(16) << f
                 << fixed << setprecision(3) << setw(18) << ms;
            if (prevMs > 0) cout << setprecision(1) << ms / prevMs;
            else            cout << "-";
            cout << endl;
            prevMs = ms;
        }

        cout << "\nIterative Fibonacci (average of 5 runs)\n";
        cout << left << setw(10) << "n" << setw(18) << "time (us)" << endl;

        for (int n : {20, 25, 30, 35, 1000, 1000000}) {
            double totalUs = 0;
            for (int r = 0; r < 5; r++) {
                auto s = high_resolution_clock::now();
                unsigned long long f = fibIterative(n);
                auto e = high_resolution_clock::now();
                totalUs += duration<double, micro>(e - s).count();
                checksumFib += f;
            }
            cout << left << setw(10) << n << fixed << setprecision(3)
                 << setw(18) << totalUs / 5 << endl;
        }
        cout << "(checksum " << checksumFib << ")" << endl;
    }

    {
        const int INSERT_RUNS = 5, SEARCH_RUNS = 20;
        long long checksumDS = 0;

        for (int n : {100000, 1000000}) {
            int key = n - 10;

            vector<int> v;
            int* arr = nullptr;
            Node* head = nullptr;
            double insV = 0, insA = 0, insL = 0, seV = 0, seA = 0, seL = 0;

            for (int r = 0; r < INSERT_RUNS; r++) {
                vector<int>().swap(v);
                insV += timeUs([&] { for (int i = 0; i < n; i++) v.push_back(i); });

                delete[] arr;
                insA += timeUs([&] { arr = new int[n]; for (int i = 0; i < n; i++) arr[i] = i; });

                freeList(head); head = nullptr;
                insL += timeUs([&] { head = buildList(n); });
            }
            for (int r = 0; r < SEARCH_RUNS; r++) {
                seV += timeUs([&] { checksumDS += searchVector(v, key); });
                seA += timeUs([&] { checksumDS += searchArray(arr, n, key); });
                seL += timeUs([&] { checksumDS += searchList(head, key); });
            }
            insV /= INSERT_RUNS; insA /= INSERT_RUNS; insL /= INSERT_RUNS;
            seV /= SEARCH_RUNS;  seA /= SEARCH_RUNS;  seL /= SEARCH_RUNS;

            cout << "\nn = " << n << "   sizeof(Node) = " << sizeof(Node) << " bytes\n";
            cout << left << setw(14) << "Structure"
                 << setw(16) << "Insert (ms)" << setw(16) << "Search (us)"
                 << setw(16) << "Bytes/element" << setw(14) << "Total bytes" << endl;
            cout << fixed << setprecision(3);
            cout << left << setw(14) << "vector"
                 << setw(16) << insV / 1000 << setw(16) << seV
                 << setw(16) << (double)(v.capacity() * sizeof(int)) / n
                 << v.capacity() * sizeof(int) << endl;
            cout << left << setw(14) << "raw array"
                 << setw(16) << insA / 1000 << setw(16) << seA
                 << setw(16) << (double)sizeof(int)
                 << (long long)n * sizeof(int) << endl;
            cout << left << setw(14) << "linked list"
                 << setw(16) << insL / 1000 << setw(16) << seL
                 << setw(16) << (double)sizeof(Node)
                 << (long long)n * sizeof(Node) << endl;

            delete[] arr;
            freeList(head);
        }
        cout << "(checksum " << checksumDS << ")" << endl;
    }

    return 0;
}
